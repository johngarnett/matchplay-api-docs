{
   "name": "matchplay-api-docs",
   "version": "1.0.0",
   "description": "Reference documentation for the Match Play Events API, with an OpenAPI spec reconstructed from observed traffic",
   "private": true,
   "type": "commonjs",
   "engines": {
      "node": ">=24"
   },
   "scripts": {
      "build": "node src/build.js",
      "start": "npm run build && node server.js",
      "dev": "node --watch src/build.js",
      "probe": "node scripts/probe.js",
      "test": "node --test 'tests/*.test.js'"
   },
   "dependencies": {
      "express": "^5.1.0",
      "markdown-it": "^14.1.0",
      "markdown-it-anchor": "^9.2.0",
      "markdown-it-attrs": "^5.0.1",
      "yaml": "^2.8.1"
   },
   "devDependencies": {
      "@playwright/test": "^1.55.0",
      "ajv": "^8.17.1",
      "ajv-formats": "^3.0.1"
   }
}
